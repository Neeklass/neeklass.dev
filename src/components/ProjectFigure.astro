---
import { labels, type Locale } from '../i18n';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Figure number, counted per page (Abb. 1, Abb. 2, …). */
  number: number;
  locale: Locale;
}
const { src, alt, width, height, number, locale } = Astro.props;
const ui = labels[locale];
---

<figure class="project-figure">
  <a class="figure-image" href={src}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    <span class="figure-number">{ui.figure} {number}</span>
    <slot />
    <a class="figure-link" href={src}>{ui.openFullImage}</a>
  </figcaption>
</figure>
