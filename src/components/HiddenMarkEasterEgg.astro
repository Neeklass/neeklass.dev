---
import { labels, type Locale } from '../i18n';

interface Props {
  variant: '404' | 'footer';
  size?: number;
  locale?: Locale;
}
const { variant, size = variant === '404' ? 180 : 52, locale = 'de' } = Astro.props;
const clipId = `neeklass-face-${crypto.randomUUID()}`;
const full = variant === '404';
// One center and radius define the orb, its outline, and its inset face clip.
const orb = { cx: 301, cy: 281, r: 114 };
const faceInset = 8;
---
<span class:list={['hidden-mark', variant === 'footer' && 'hidden-mark--footer']} style={`--reveal-size:${size}px`}>
  <button class="hidden-mark__button" type="button" data-hidden-mark aria-pressed="false" aria-label={labels[locale].hiddenSignature} disabled>
    <svg class="hidden-mark__svg" viewBox="0 0 480 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id={clipId} clipPathUnits="userSpaceOnUse"><circle cx={orb.cx} cy={orb.cy} r={orb.r - faceInset} /></clipPath>
      </defs>
      <g class="hidden-mark__rear" aria-hidden="true">
        <path class="hidden-mark__ear" d="M113 81 L235 187 L151 257 L116 228 Z" />
        <path class="hidden-mark__ear" d="M242 112 L364 207 L291 252 L232 228 Z" />
        {full && (
          <>
            <path class="hidden-mark__shade" d="M137 120 L182 168 L149 156 Z" />
            <path class="hidden-mark__shade" opacity=".5" d="M260 153 L304 190 L264 189 Z" />
          </>
        )}
        <!-- Close the bracket behind the module; its visible v8 silhouette stays intact. -->
        <path class="hidden-mark__bracket" d="M169 238 L64 282 L169 325 Z" />
        <circle class="hidden-mark__side-ring" cx="160" cy="281" r="47" />
        <circle class="hidden-mark__side-center" cx="160" cy="281" r="30" />
      </g>
      <g class="hidden-mark__letter" transform="translate(80 385) scale(.60)" aria-hidden="true">
        <path fill="currentColor" d="M450 -250L390 -250Q390 -329 377.5 -373Q365 -417 339.5 -435Q314 -453 274 -453L274 -508Q358 -508 402.5 -454.5Q447 -401 449 -302ZM85 -500L145 -500L145 0L85 0ZM390 -250L450 -250L450 0L390 0ZM117 -350L85 -360Q85 -360 94 -375Q103 -390 120 -412Q137 -434 160.5 -456Q184 -478 213 -493Q242 -508 275 -508L275 -453Q241 -453 212 -437.5Q183 -422 161.5 -401.5Q140 -381 128.5 -365.5Q117 -350 117 -350ZM95 -445L15 -465L15 -500L95 -500ZM135 0L135 -55L215 -35L215 0ZM15 0L15 -35L95 -55L95 0ZM440 0L440 -55L520 -35L520 0Z" />
      </g>
      <g class="hidden-mark__orb-motion" aria-hidden="true">
        <circle class="hidden-mark__orb" {...orb} />
        <g clip-path={`url(#${clipId})`}>
          <g class="hidden-mark__features">
            <path class="hidden-mark__eye" d="M263 253 L283 263" />
            {full && <path class="hidden-mark__mouth" d="M305 338 H323 V346 H340 V354 H357 V362 H369" />}
          </g>
        </g>
        <circle class="hidden-mark__orb-outline" {...orb} />
      </g>
    </svg>
  </button>
</span>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-hidden-mark]');
  buttons.forEach(button => {
    button.disabled = false;
    const setOpen = (open: boolean) => button.setAttribute('aria-pressed', String(open));
    const close = () => setOpen(false);

    // Touch uses click only, avoiding synthetic/sticky hover and focus reveals.
    button.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse') setOpen(true);
    });
    button.addEventListener('pointerleave', event => {
      if (event.pointerType === 'mouse' && !button.matches(':focus-visible')) close();
    });
    button.addEventListener('focus', () => {
      if (button.matches(':focus-visible')) setOpen(true);
    });
    button.addEventListener('blur', close);
    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-pressed') !== 'true');
    });
    document.addEventListener('pointerdown', event => {
      if (event.target instanceof Node && !button.contains(event.target)) close();
    });
    document.addEventListener('keydown', event => {
      // Keep keyboard focus in place, even when dismissing a hover reveal.
      if (event.key === 'Escape') close();
    });
  });
</script>

<style>
  .hidden-mark {
    --mark-ink: var(--foreground);
    --mark-ground: var(--background);
    --mark-accent: var(--accent);
    --mark-face-ink: var(--background);
    color: var(--mark-ink);
    display: inline-flex;
    flex: none;
    width: max(44px, var(--reveal-size));
    max-width: 100%;
    vertical-align: middle;
  }

  .hidden-mark__button {
    display: grid;
    place-items: center;
    width: 100%;
    min-width: 44px;
    min-height: 44px;
    aspect-ratio: 1;
    color: inherit;
    border: 0;
    background: transparent;
    padding: 0;
    border-radius: .375rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .hidden-mark__button:disabled {
    cursor: default;
    opacity: 1;
  }

  .hidden-mark__button:focus-visible {
    outline: 2px solid var(--mark-accent);
    outline-offset: 3px;
  }

  .hidden-mark__svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .hidden-mark__letter {
    opacity: 1;
    transition: opacity 180ms ease;
  }

  .hidden-mark__orb-motion {
    transform-box: view-box;
    transform-origin: 301px 281px;
    transform: translate(104px, 86px) scale(.2105263158);
    transition: transform 560ms cubic-bezier(.25,.72,.2,1);
  }

  .hidden-mark__orb {
    fill: var(--mark-accent);
  }

  .hidden-mark__orb-outline {
    fill: none;
    stroke: var(--mark-ink);
    stroke-width: 9;
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .hidden-mark__rear {
    opacity: 0;
    transform: translate(8px,4px) scale(.98);
    transform-origin: 220px 281px;
    transition: transform 380ms cubic-bezier(.25,.72,.2,1), opacity 180ms ease;
  }

  .hidden-mark__ear {
    fill: var(--mark-ground);
    stroke: var(--mark-ink);
    stroke-width: 8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .hidden-mark__shade {
    fill: var(--brand-ice);
  }

  .hidden-mark__bracket {
    fill: none;
    stroke: var(--mark-ink);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hidden-mark__side-ring {
    fill: var(--mark-ground);
    stroke: var(--mark-ink);
    stroke-width: 9;
  }

  .hidden-mark__side-center {
    fill: var(--mark-accent);
    stroke: var(--mark-ink);
    stroke-width: 6;
  }

  .hidden-mark__features {
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .hidden-mark__eye {
    fill: none;
    stroke: var(--mark-face-ink);
    stroke-width: 13;
    stroke-linecap: round;
  }

  .hidden-mark__mouth {
    fill: none;
    stroke: var(--mark-face-ink);
    stroke-width: 5;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .hidden-mark__button[aria-pressed="true"] .hidden-mark__letter {
    opacity: 0;
  }

  .hidden-mark__button[aria-pressed="true"] .hidden-mark__orb-motion {
    transform: none;
  }

  .hidden-mark__button[aria-pressed="true"] .hidden-mark__rear {
    transform: none;
    opacity: 1;
    transition-delay: 80ms;
  }

  .hidden-mark__button[aria-pressed="true"] .hidden-mark__orb-outline {
    opacity: 1;
    transition-delay: 400ms;
  }

  .hidden-mark__button[aria-pressed="true"] .hidden-mark__features {
    opacity: 1;
    transition-delay: 410ms;
  }

  .hidden-mark--footer .hidden-mark__ear {
    stroke-width: 12;
  }

  .hidden-mark--footer .hidden-mark__bracket {
    stroke-width: 14;
  }

  .hidden-mark--footer .hidden-mark__side-ring {
    stroke-width: 11;
  }

  .hidden-mark--footer .hidden-mark__side-center {
    stroke-width: 7;
  }

  .hidden-mark--footer .hidden-mark__orb-outline {
    stroke-width: 10;
  }

  .hidden-mark--footer .hidden-mark__eye {
    stroke-width: 18;
  }

  @media (prefers-reduced-motion: reduce) {
    .hidden-mark * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
