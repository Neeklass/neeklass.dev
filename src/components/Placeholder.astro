---
// Marks copy that Niklas still has to write (see docs/content-guide.md).
// Visible in development; a production build fails while any placeholder is
// rendered, so unfinished copy can never be deployed by accident. Tests that
// build fixtures may opt out with ALLOW_COPY_PLACEHOLDERS=1.
interface Props {
  hint: string;
}
const { hint } = Astro.props;
const env = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env;
if (import.meta.env.PROD && env?.ALLOW_COPY_PLACEHOLDERS !== '1') {
  throw new Error(`Unfilled copy placeholder: "${hint}" (${Astro.url.pathname}). Replace it with real copy before building for production.`);
}
---

<mark class="copy-placeholder" data-placeholder>[{hint}]</mark>

<style>
  .copy-placeholder {
    background: none;
    color: var(--accent);
    outline: 1px dashed var(--accent);
    outline-offset: 2px;
  }
</style>
