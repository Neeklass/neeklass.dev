---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="introduction" aria-labelledby="name">
    <p class="eyebrow">Software Engineer · Computer Science Student</p>
    <h1 id="name">Niklas Dittmann{' '}<span class="role">Software Engineer.</span></h1>
    <p class="lead">
      I build software and explore data,<br class="wide-break" /> systems and applied AI.
    </p>
    <p class="intro-note">
      Interested in the ideas behind useful software:<br class="wide-break" /> from backend systems to developer tools.
    </p>
  </section>

  <section class="site-direction" aria-labelledby="direction-title">
    <div class="direction-intro">
      <h2 id="direction-title">A place for the work<br class="wide-break" /> and the thinking.</h2>
      <p>
        This is my corner of the web for projects, technical writing and experiments.
        A collection that will grow over time.
      </p>
    </div>
    <ol class="future-sections">
      <li>
        <span class="section-number" aria-hidden="true">01</span>
        <span>Projects</span>
        <span class="section-note">Things I build</span>
      </li>
      <li>
        <span class="section-number" aria-hidden="true">02</span>
        <span>Writing</span>
        <span class="section-note">Ideas I explore</span>
      </li>
      <li>
        <span class="section-number" aria-hidden="true">03</span>
        <span>About</span>
        <span class="section-note">The person behind it</span>
      </li>
    </ol>
  </section>
</BaseLayout>
