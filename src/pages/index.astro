---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePaths } from '../i18n';
---

<BaseLayout
  locale="de"
  title="Niklas Dittmann — Softwareentwickler"
  description="Niklas Dittmann, Softwareentwickler und Informatikstudent. Mein persönlicher Ort für Projekte, technische Artikel und Experimente mit Software, Systemen, Daten und angewandter KI."
  translations={homePaths}
>
  <section class="introduction" aria-labelledby="name">
    <p class="eyebrow">Softwareentwickler · Informatikstudent</p>
    <h1 id="name">Niklas Dittmann{' '}<span class="role">Software Engineer.</span></h1>
    <p class="lead">
      Ich entwickle Software und beschäftige mich mit<br class="wide-break" /> Daten, Systemen und angewandter KI.
    </p>
    <p class="intro-note">
      Mich interessieren die Ideen hinter nützlicher Software:<br class="wide-break" /> von Backend-Systemen bis zu Entwicklertools.
    </p>
  </section>

  <section class="site-direction" aria-labelledby="direction-title">
    <div class="direction-intro">
      <h2 id="direction-title">Ein Ort fürs Bauen<br class="wide-break" /> und Weiterdenken.</h2>
      <p>
        Hier sammle ich Projekte, technische Artikel und Experimente.
        Mein persönlicher Ort im Web, der mit der Zeit wächst.
      </p>
    </div>
    <ol class="future-sections">
      <li>
        <span class="section-number" aria-hidden="true">01</span>
        <span>Projekte</span>
        <span class="section-note">Was ich entwickle</span>
      </li>
      <li>
        <span class="section-number" aria-hidden="true">02</span>
        <span>Artikel</span>
        <span class="section-note">Was mich beschäftigt</span>
      </li>
      <li>
        <span class="section-number" aria-hidden="true">03</span>
        <span>Über mich</span>
        <span class="section-note">Der Mensch dahinter</span>
      </li>
    </ol>
  </section>
</BaseLayout>
