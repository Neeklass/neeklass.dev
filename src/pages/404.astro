---
import BaseLayout from '../layouts/BaseLayout.astro';
import Glyph from '../components/Glyph.astro';
import { homePaths } from '../i18n';
---

<BaseLayout
  locale="de"
  title="404 — Seite nicht gefunden / Page not found — neeklass"
  description="Diese Seite existiert nicht. This page does not exist."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-copy">
      <h1 id="not-found-title">404</h1>
      <p class="lead">
        Diese Seite existiert nicht.<br />
        <span lang="en">This page does not exist.</span>
      </p>
      <p class="back-home">
        <a href={homePaths.de}>← Zur Startseite / <span lang="en">Back home</span></a>
      </p>
    </div>
    <Glyph variant="404" />
  </section>
</BaseLayout>

<style>
  .not-found {
    margin-block: clamp(3.5rem, 8vw, 6.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 46rem;
  }

  h1 {
    margin-top: 0;
  }

  .back-home {
    margin-top: var(--space-4);
    line-height: 1.6;
  }
</style>
